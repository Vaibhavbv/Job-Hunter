# Local dev secrets for Supabase Edge Functions.
# Copy to supabase/.env and run: supabase functions serve --env-file supabase/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are reserved
# names that Supabase auto-injects into every deployed Edge Function — you
# do NOT set those yourself in production. They're only listed here because
# `supabase functions serve` needs them for local emulation.
#
# The other keys are the secrets you actually push to production, via:
#   supabase secrets set GEMINI_API_KEY=... APIFY_TOKEN=... RAZORPAY_KEY_ID=... \
#     RAZORPAY_KEY_SECRET=... RAZORPAY_WEBHOOK_SECRET=...

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API key — used by parse-resume, rewrite-resume, evaluate-jobs, score-jobs
GEMINI_API_KEY=your-gemini-api-key

# Apify API token — used by fetch-jobs, ingest-webhook, check-credits
APIFY_TOKEN=your-apify-token

# Razorpay — used by razorpay-checkout (key id + secret) and razorpay-webhook
# (webhook secret). Get key id/secret from Razorpay Dashboard → API Keys;
# set the webhook secret yourself when creating the webhook (point it at
# <project>.supabase.co/functions/v1/razorpay-webhook, event: payment.captured).
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Lock edge-function CORS to your deployed frontend origin (e.g.
# https://your-app.vercel.app). Unset = "*" (open), for local dev.
ALLOWED_ORIGIN=
